{
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git reset --hard*)",
      "Bash(*git filter-branch*)",
      "Bash(*git update-ref *-d*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git reset --hard*)",
      "PowerShell(*git filter-branch*)",
      "PowerShell(*git update-ref *-d*)",
      "PowerShell(*Format-Volume*)",
      "PowerShell(*Clear-Disk*)",
      "Edit(.workflow/state/kill-tokens/**)",
      "Write(.workflow/state/kill-tokens/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/dispatch_prompt.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/phase_dispatch.py\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/agent_dispatch.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/clear_offer.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/phase_dispatch.py\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/auto_dev_keep.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/clear_offer.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/bash_command.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/agent_source_read.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/process_kill.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/auto_dev_keep.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/clear_offer.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/mutation_command.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/repro_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/story_write_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/propagate_paths.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/powershell_command.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/agent_source_read.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/process_kill.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/auto_dev_keep.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/clear_offer.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/mutation_command.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/repro_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/story_write_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/propagate_paths.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/review_run_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/review_code_paths.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/repro_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/story_write_paths.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/propagate_paths.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/land_lease_wait.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "StructuredOutput",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/review_coverage.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/script_registration.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/scripts/check_agent_frontmatter.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "auto-dev-loop",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/auto_dev_keep.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_journal.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/land_lease_wait.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_journal.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_journal.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/agent_outcome.py\" --role repro",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_retrospective.py\" --tool claude",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_retrospective.py\" --tool claude",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_start.py\" startup",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_start.py\" clear",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_start.py\" compact",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_start.py\" resume",
            "timeout": 90
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/notification.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/notification.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/instructions_loaded.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
