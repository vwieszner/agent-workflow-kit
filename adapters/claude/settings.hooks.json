{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/dispatch_prompt.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/phase_dispatch.py\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/phase_dispatch.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/bash_command.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/agent_source_read.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/powershell_command.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/agent_source_read.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/graph_query.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/mcp_readonly.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/guards/script_registration.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_journal.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/write_handoff.py\" --tool claude"
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_retrospective.py\""
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_retrospective.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/check_pending_proposals.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_story_ledger.py\""
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/check_pending_proposals.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_story_ledger.py\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_handoff.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_symbol_nav_directive.py\" --tool claude"
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_story_ledger.py\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_handoff.py\""
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_symbol_nav_directive.py\" --tool claude"
          },
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/inject_story_ledger.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.workflow/hooks/session/session_journal.py\""
          }
        ]
      }
    ]
  }
}
