{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git commit --no-verify*": "deny",
      "rm -rf /*": "deny"
    },
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
